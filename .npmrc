# GitHub Packages only accepts a scope equal to the repository owner. Moving
# this setup to entry-fi/web-libs means replacing @olegshilov with @entry-fi
# here, in .changeset/config.json and in the three package names.
# The token is never committed: locally it lives in ~/.npmrc, in CI in a
# job-scoped npmrc under $RUNNER_TEMP.
@olegshilov:registry=https://npm.pkg.github.com
