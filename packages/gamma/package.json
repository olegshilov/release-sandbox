{
  "name": "@olegshilov/sandbox-gamma",
  "version": "0.2.1",
  "description": "Release sandbox: an optional peer of alpha; it is bumped only when an alpha release leaves its peer range.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olegshilov/release-sandbox.git",
    "directory": "packages/gamma"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo",
    "!**/*.test.ts"
